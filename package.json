{
  "name": "job-tracker",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx src/server/db/seed.ts",
    "demo:pdfs": "tsx scripts/build-demo-pdfs.ts",
    "eval:classifier": "tsx --conditions=react-server --env-file=.env scripts/eval-classifier.ts",
    "perf:seed": "tsx scripts/perf-seed.ts",
    "perf:measure": "tsx scripts/perf-measure.ts",
    "screenshots": "tsx scripts/screenshots.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "@base-ui/react": "^1.9.0",
    "@dnd-kit/core": "^6.3.1",
    "@googleapis/gmail": "^22.0.2",
    "better-sqlite3": "^13.0.3",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "drizzle-orm": "^0.45.4",
    "google-auth-library": "^11.3.1",
    "lucide-react": "^1.57.0",
    "mammoth": "^1.13.0",
    "next": "16.4.2",
    "next-auth": "5.0.0-beta.32",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.21.5",
    "tw-animate-css": "^1.4.0",
    "unpdf": "^1.9.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "jszip": "^3.10.2",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@12.11.2"
}
