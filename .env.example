# "true" makes the whole deployment demo-only: read-only, seeded DB, no auth.
DEMO_MODE=false

# The only Google account allowed to sign in (live mode).
ALLOWED_EMAIL=you@example.com

# Auth.js session encryption secret. Generate with: npx auth secret
AUTH_SECRET=

# Google OAuth credentials (live mode auth). Create an OAuth client in
# Google Cloud Console and register this authorized redirect URI:
#   http://localhost:3000/api/auth/callback/google (dev)
#   https://<your-domain>/api/auth/callback/google (prod)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Anthropic API key (optional until Phase 2+).
ANTHROPIC_API_KEY=

# Path to the live SQLite database file.
DATABASE_PATH=./data/app.db
