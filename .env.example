# "true" makes the whole deployment demo-only: read-only, seeded DB, no auth.
DEMO_MODE=false

# The only Google account allowed to sign in (live mode).
ALLOWED_EMAIL=you@example.com

# Auth.js session encryption secret. Generate with: npx auth secret
AUTH_SECRET=

# Google OAuth credentials (live mode auth). Create an OAuth client in
# Google Cloud Console and register this authorized redirect URI:
#   http://localhost:3000/api/auth/callback/google (dev)
#   https://<your-domain>/api/auth/callback/google (prod)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Anthropic API key. Optional in demo mode (demo uses canned results and
# never calls the API). Required in live mode to run a resume comparison.
ANTHROPIC_API_KEY=

# Model for comparisons and cover letters. Defaults to claude-opus-5-5.
# ANTHROPIC_MODEL=claude-opus-5-5

# Tectonic, for compiling LaTeX resumes to PDF (live mode only; the demo
# serves pre-built PDFs). Defaults to "tectonic" on PATH. A full path is
# more reliable, e.g. on Windows:
# TECTONIC_PATH=C:\Users\<you>\AppData\Local\Programs\tectonic\tectonic.exe
# The app compiles offline (--only-cached): compile your resume once from
# a terminal (tectonic -X compile resume.tex) to download its packages.

# Path to the live SQLite database file.
DATABASE_PATH=./data/app.db
