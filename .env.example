# "true" makes the whole deployment demo-only: read-only, seeded DB, no auth.
# The demo needs nothing else from this file (see "Hosted demo" in README).
DEMO_MODE=false

# The only Google account allowed to sign in. Required in live mode.
ALLOWED_EMAIL=you@example.com

# Auth.js session encryption secret. Required in live mode.
# Generate with: npx auth secret
AUTH_SECRET=

# Google OAuth credentials (live mode auth, and connecting Gmail). Create an
# OAuth client in Google Cloud Console and register both authorized
# redirect URIs:
#   http://localhost:3000/api/auth/callback/google  (sign-in)
#   http://localhost:3000/api/gmail/callback        (Connect Gmail)
# For Gmail, also enable the Gmail API and add the gmail.readonly scope and
# your address as a test user on the consent screen (docs/gmail-sync.md).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Anthropic API key. Optional in demo mode (demo uses canned results and
# never calls the API). Required in live mode to run a resume comparison.
ANTHROPIC_API_KEY=

# Model for comparisons and cover letters. Defaults to claude-opus-5-5.
# ANTHROPIC_MODEL=claude-opus-5-5

# Model for classifying Gmail emails: short, simple, many per sync, so the
# fast, low-cost model by default. Measure a change with pnpm eval:classifier.
# ANTHROPIC_CLASSIFIER_MODEL=claude-haiku-5-5

# Tectonic, for compiling LaTeX resumes to PDF (live mode only; the demo
# serves pre-built PDFs). Defaults to "tectonic" on PATH. A full path is
# more reliable, e.g. on Windows:
# TECTONIC_PATH=C:\Users\<you>\AppData\Local\Programs\tectonic\tectonic.exe
# The app compiles offline (--only-cached): compile your resume once from
# a terminal (tectonic -X compile resume.tex) to download its packages.

# Encrypts stored Gmail refresh tokens. Required to connect Gmail, not for
# demo mode. 32 random bytes, base64. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Keep it out of database backups. Losing or changing it only means
# reconnecting Gmail.
TOKEN_ENCRYPTION_KEY=

# Where the app is reached; builds the Gmail redirect URI above. Defaults to
# http://localhost:3000.
# APP_URL=http://localhost:3000

# Path to the live SQLite database file.
DATABASE_PATH=./data/app.db
